// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  SUPERADMIN
  ADMIN
  GUEST
}

enum AvailabilityStatus {
  AVAILABLE
  UNAVAILABLE
  MAINTENANCE
}

model User {
  id Int @id @default(autoincrement())
  firstName    String
  lastName     String
  email        String   @unique
  role         Role     @default(USER)
  passwordHash String
  passwordSalt String
  emailVerified Boolean  @default(false)
  verificationToken String?
  addresses Address[]
}

model Address {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id])
  firstName    String
  lastName     String
  addressLine1 String
  addressLine2 String?
  city         String
  postalCode   String
  country      String
  mobile       String?
  isDefault    Boolean  @default(false) 
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  image       String?
  link        String?
  priority    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  services    Service[]
}

model Service {
  id           Int   @id @default(autoincrement())
  name         String
  summary      String
  description  String?
  technicalCharacteristics String?
  companyBenefits String?
  categoryId   Int? 
  category    Category? @relation(fields: [categoryId], references: [id]) 
  monthlyPrice Decimal  @db.Decimal(10,2)
  annualPrice  Decimal  @db.Decimal(10,2)
  perUserPrice Decimal  @db.Decimal(10,2)
  perDevicePrice Decimal  @db.Decimal(10,2)
  maxResources Int
  usedResources Int @default(0) 
  availability AvailabilityStatus  @default(AVAILABLE) 
  priority      Int     @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  images Json?
  topService TopService[]
} 

model TopService {
  id          Int       @id @default(autoincrement())
  serviceId   Int
  service     Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  priority    Int       @default(0)
  startDate   DateTime  @default(now())
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}



model TextSection  {
  id    Int    @id @default(autoincrement())
  content  String
}

model CarouselItem {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  image       String
  link        String
  priority      Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}