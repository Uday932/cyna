generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role{
  USER
  SUPERADMIN
  ADMIN
  GUEST
}

model User {
  id Int @id @default(autoincrement())
  firstName    String
  lastName     String
  email        String   @unique
  role         Role     @default(USER)
  passwordHash String
  passwordSalt String
  emailVerified Boolean  @default(false)
  verificationToken String?
 }

model Service {
  id           Int   @id @default(autoincrement())
  name         String
  summary      String
  description  String?
  technicalCharacteristics String?
  companyBenefits String?
  category     String?
  monthlyPrice Decimal  @db.Decimal(10,2)
  annualPrice  Decimal  @db.Decimal(10,2)
  perUserPrice Decimal  @db.Decimal(10,2)
  perDevicePrice Decimal  @db.Decimal(10,2)
  maxResources Int
  availability String  @default("disponible") 
  usedResources Int @default(0) 
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  images Json?
} 
